// ============================================================
// AUTH: users, userProfiles, accounts, sessions
// ============================================================

model User {
  id         String    @id @default(cuid()) @db.VarChar(36)
  name       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  verifiedAt DateTime? @db.DateTime(3)
  image      String?   @db.VarChar(2048)
  // Daftar role user: "researcher", "respondent", dan/atau "admin"
  roles      Json      @default("[\"researcher\", \"respondent\"]")
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  deletedAt  DateTime? @db.DateTime(3)

  // auth
  profile  UserProfile?
  accounts Account[]
  sessions Session[]
  verifications Verification[]

  // account settings
  setting UserSetting?

  // research
  researches Research[] @relation("ResearcherResearches")

  // participation
  participations         RespondentParticipation[] @relation("RespondentParticipations")
  reviewedParticipations RespondentParticipation[] @relation("ParticipationAdminReviewer")

  // payment
  payments Payment[]

  // token
  tokenWallet TokenWallet?

  // moderation
  reviewedQualityChecks  QualityCheck[]  @relation("QualityCheckReviewer")
  reportedContents       ContentReport[] @relation("ContentReportReporter")
  reviewedContentReports ContentReport[] @relation("ContentReportReviewer")

  // support
  supportTickets         SupportTicket[] @relation("SupportTicketRequester")
  reviewedSupportTickets SupportTicket[] @relation("SupportTicketReviewer")

  @@map("users")
}

model UserProfile {
  id     String @id @default(cuid()) @db.VarChar(36)
  userId String @unique @db.VarChar(36)

  gender            String    @db.VarChar(50)
  religion          String    @db.VarChar(50)
  religionConsentAt DateTime? @db.DateTime(3)

  domicileProvince   String    @db.VarChar(100)
  domicileCity       String    @db.VarChar(100)
  domicileLat        Decimal   @db.Decimal(10, 7)
  domicileLng        Decimal   @db.Decimal(10, 7)
  domicileVerifiedAt DateTime? @db.DateTime(3)

  education  String @db.VarChar(100)
  occupation String @db.VarChar(100)

  // Nomor WhatsApp/telepon, dipakai untuk verifikasi & notifikasi
  phoneNumber String? @map("phone_number") @db.VarChar(20)

  dataShareConsentAt DateTime? @db.DateTime(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Account {
  id         String  @id @default(cuid()) @db.VarChar(36)
  userId     String  @db.VarChar(36)
  accountId  String  @db.VarChar(255)
  providerId String  @db.VarChar(100)
  // null untuk akun OAuth; hash untuk credential
  password   String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.DateTime(3)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(512)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_VERIFICATION
}

model Verification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  type      VerificationType
  // Simpan hash token, bukan token mentah. Unique agar lookup cepat & tidak bentrok.
  tokenHash String           @unique @map("token_hash") @db.VarChar(255)
  // Kode OTP pendek (opsional), mis. 6 digit
  code      String?          @db.VarChar(10)
  // Tujuan yang sedang diverifikasi, mis. email baru saat ganti email
  target    String?          @db.VarChar(255)
  // Berapa kali kode salah dimasukkan, untuk membatasi brute force
  attempts  Int              @default(0)
  expiredAt DateTime         @map("expired_at") @db.DateTime(3)

  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiredAt])
  @@map("verifications")
}
